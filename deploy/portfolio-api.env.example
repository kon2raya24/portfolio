# Copy this to /etc/portfolio-api.env on the server and fill in a real password.
#   sudo cp deploy/portfolio-api.env.example /etc/portfolio-api.env
#   sudo nano /etc/portfolio-api.env        # set ADMIN_PASSWORD
#   sudo chmod 600 /etc/portfolio-api.env   # keep the secret root-readable only
#
# Generate a strong password:  openssl rand -base64 24

PORT=3000
HOST=127.0.0.1
DATA_DIR=/var/www/portfolio/server/data
ADMIN_PASSWORD=CHANGE_ME_use_openssl_rand_base64_24
